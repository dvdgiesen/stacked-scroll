{
  "name": "stacked-scroll",
  "version": "1.2.0",
  "description": "Idiomatic GSAP ScrollTrigger + Observer library that turns sections into a stack of pages with pinned headers, vertical/horizontal page turns, deep-linking, scroll anchoring, and fullscreen guard.",
  "type": "module",
  "main": "./dist/stacked-scroll.umd.cjs",
  "module": "./dist/stacked-scroll.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/stacked-scroll.js",
      "require": "./dist/stacked-scroll.umd.cjs"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvdgiesen/stacked-scroll.git"
  },
  "homepage": "https://dvdgiesen.github.io/stacked-scroll/",
  "bugs": "https://github.com/dvdgiesen/stacked-scroll/issues",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepack": "npm run build",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "gsap",
    "scrolltrigger",
    "gsap-observer",
    "scroll",
    "pin",
    "pinned-sections",
    "sticky-header",
    "section",
    "stacked-pages",
    "stacked-scroll",
    "page-turn",
    "page-transition",
    "touch-swipe",
    "fullpage",
    "full-page-scroll",
    "scroll-effect",
    "editorial",
    "scrollytelling",
    "deep-link",
    "scroll-jacking-alternative"
  ],
  "author": "Dirk van der Giesen <dvdgiesen@yahoo.com>",
  "license": "MIT",
  "peerDependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "gsap": "^3.13.0",
    "vite": "^5.0.0"
  }
}
