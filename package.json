{
  "name": "paged-scroll",
  "version": "1.0.0",
  "description": "A small, hardened library for the newspaper page-turn scroll effect using GSAP ScrollTrigger.",
  "type": "module",
  "main": "./dist/paged-scroll.umd.cjs",
  "module": "./dist/paged-scroll.js",
  "exports": {
    ".": {
      "import": "./dist/paged-scroll.js",
      "require": "./dist/paged-scroll.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "gsap",
    "scrolltrigger",
    "scroll",
    "pin",
    "section",
    "page-turn",
    "paged-scroll"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "gsap": "^3.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "gsap": "^3.12.0",
    "vite": "^5.0.0"
  }
}
