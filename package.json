{
  "name": "stacked-scroll",
  "version": "1.0.0",
  "description": "A small, hardened library for the stacked-pages scroll effect using GSAP ScrollTrigger.",
  "type": "module",
  "main": "./dist/stacked-scroll.umd.cjs",
  "module": "./dist/stacked-scroll.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/stacked-scroll.js",
      "require": "./dist/stacked-scroll.umd.cjs"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dvdgiesen/stacked-scroll.git"
  },
  "homepage": "https://github.com/dvdgiesen/stacked-scroll#readme",
  "bugs": "https://github.com/dvdgiesen/stacked-scroll/issues",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepack": "npm run build",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "gsap",
    "scrolltrigger",
    "scroll",
    "pin",
    "pinned-sections",
    "section",
    "stacked-pages",
    "stacked-scroll",
    "fullpage",
    "full-page-scroll",
    "scroll-effect",
    "editorial",
    "scrollytelling",
    "deep-link",
    "scroll-jacking-alternative"
  ],
  "author": "Dirk van der Giesen <dvdgiesen@yahoo.com>",
  "license": "MIT",
  "peerDependencies": {
    "gsap": "^3.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "gsap": "^3.12.0",
    "vite": "^5.0.0"
  }
}
